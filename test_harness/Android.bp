// This file contains all the build target that we expect tests writers
// to need to build tests.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_import_host {
    name: "tradefed",
    jars: [
        ":platformprotos", // Should be first to force using protos from the branch
        ":tradefed-prebuilt",
    ],
    installable: true,
}

// Target used for backward compatibility with suites
java_import_host {
    name: "tradefed-no-fwk",
    jars: [":tradefed-prebuilt"],
    installable: true,
}

java_import_host {
    name: "loganalysis",
    jars: [":loganalysis-prebuilt"],
    installable: true,
}

// Targets for test suites
java_import_host {
    name: "compatibility-tradefed",
    jars: [":compatibility-tradefed-prebuilt"],
    installable: true,
}

java_import_host {
    name: "compatibility-host-util",
    jars: [":compatibility-host-util-prebuilt"],
    installable: true,
}

java_genrule_host {
    name: "prebuilt_tradefed_zip",
    tools: ["soong_zip"],
    srcs: [
        ":tradefed",
        ":tradefed_dist_artifacts",
        ":compatibility-tradefed-prebuilt",
        ":compatibility-host-util-prebuilt",
    ],
    out: ["tradefed.zip"],
    cmd: "mkdir -p $(genDir)/tmp && " +
        "cp -f $(in) $(genDir)/tmp && " +
        "$(location soong_zip) -o $(out) -C $(genDir)/tmp -D $(genDir)/tmp",
    dist: {
        targets: ["tradefed"],
    },
    enabled: select(soong_config_variable("tradefed", "use_prebuilt"), {
        true: true,
        default: false,
    }),
    // Force disable it for windows due to the tradefed in srcs is a java_import_host
    // type which don't have windows target.
    target: {
        windows: {
            enabled: false,
        },
    },
}

phony_rule {
    name: "tradefed-core",
    phony_deps: select(soong_config_variable("tradefed", "use_prebuilt"), {
        true: [
            "tradefed",
            "atest_tradefed.sh",
        ],
        default: ["tradefed-core-src"],
    }),
}

phony_rule {
    name: "tradefed-all",
    phony_deps: select(soong_config_variable("tradefed", "use_prebuilt"), {
        true: [
            "tradefed",
            "atest_tradefed.sh",
        ],
        default: ["tradefed-all-src"],
    }),
}
